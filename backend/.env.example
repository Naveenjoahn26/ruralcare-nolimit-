# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./ruralcare.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruralcare_db

# Central Platform Server
HOST=0.0.0.0
PORT=8000
SECRET_KEY=ruralcare-central-platform-sih26133-secret-key

# Frontend Integration CORS
FRONTEND_URL=http://localhost:5173

# Dataset directory (defaults to ../data)
DATA_DIR=../data

# Real SMTP Email Provider Configuration (Direct SMTP)
# Leave blank to use Development/Simulation mode
SMTP_HOST= smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@ruralcare.gov.in
SMTP_TLS=true
SMTP_TIMEOUT=10

# Optional: Real recipient for live testing (only used when explicitly testing)
TEST_EMAIL_RECIPIENT=

# SMS Gateway Adapter (Optional / Unconfigured by default)
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=RURLCR
